# Public browser-side configuration
VITE_SITE_URL=https://your-domain.com

# Server-only Razorpay credentials. Do NOT prefix these with VITE_.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Server-only testimonial moderation
MONGODB_URI=mongodb+srv://...
MONGODB_DB=generays
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Exact browser origin for local testing (production host is accepted automatically)
APP_ORIGIN=http://localhost:3000
