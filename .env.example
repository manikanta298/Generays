# Public site configuration
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Razorpay (server-side secret must never be exposed to the browser)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: expose a public key only if you need it elsewhere.
# The checkout API returns RAZORPAY_KEY_ID from the server, so this is not required client-side.
